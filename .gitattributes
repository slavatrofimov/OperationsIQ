# Pin the bundled Python sources and their generated TS bundle to LF so that
# `npm run bundle:tsmp` is byte-deterministic across OSes. The bundle:tsmp CI
# step regenerates the bundle and fails on any diff, so a CRLF checkout on
# Windows must not change the generated bytes.
OperationsIQApp/spark/tsmp/**/*.py text eol=lf
OperationsIQApp/src/lib/mp/tsmpBundle.ts text eol=lf
