# ----------------------------------------------------------------------------
# Operations IQ app - environment configuration (Vite)
# Copy to `.env.local` (git-ignored) and fill in real values. Never commit
# real IDs/keys. The frontend is served from a PUBLIC URL, so NO secrets here -
# only public client IDs, resource URIs, and the Rayfin publishable key.
# ----------------------------------------------------------------------------

# Rayfin managed backend (GraphQL + auth + static hosting)
VITE_RAYFIN_API_URL=http://localhost:5168
VITE_RAYFIN_PUBLISHABLE_KEY=

# The deployed Fabric App item targeted by Fabric SSO
VITE_FABRIC_WORKSPACE_ID=
VITE_FABRIC_ITEM_ID=
VITE_FABRIC_PORTAL_URL=https://app.fabric.microsoft.com

# Eventhouse (read-only, queried directly from the browser via MSAL)
# Query URI looks like: https://<guid>.<region>.kusto.fabric.microsoft.com
VITE_EVENTHOUSE_QUERY_URI=
VITE_EVENTHOUSE_DB=

# Entra SPA app registration used ONLY to mint the Kusto-audience token
# (SPA platform, PKCE, no client secret, redirect URI = app origin)
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=

# ----------------------------------------------------------------------------
# Operations Advisor (optional) — Microsoft Foundry agent with tool calling.
# When unset, the Operations Advisor header button is hidden and no agent calls are made.
# The chat panel renders assistant replies as GitHub-flavored Markdown (headings,
# lists, tables, code, links), so the Foundry agent instructions should be written
# to respond in Markdown for the richest formatting. Plain prose still works.
# ----------------------------------------------------------------------------
# Foundry *project* endpoint base URL (no trailing slash). The client appends
# /openai/v1/... (the OpenAI-compatible Responses + Conversations data plane),
# e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
VITE_FOUNDRY_ENDPOINT=
# The persisted agent to run, referenced by name + version (an agent_reference).
VITE_FOUNDRY_AGENT_NAME=
# Agent version to pin to. Optional — omit to let the reference resolve by name.
VITE_FOUNDRY_AGENT_VERSION=
# OAuth scope whose token audience matches the Foundry endpoint. Acquired via the
# existing MSAL delegated flow. The
# MSAL app registration must be allowed to mint a token for this audience.
VITE_FOUNDRY_SCOPE=https://ai.azure.com/.default
# Attach tool charts to the agent as images for a multimodal 'vision' review pass.
# Requires the Foundry agent to use a multimodal (vision-capable) model. Set false to disable.
VITE_OPERATIONS_ADVISOR_VISION=true

# ----------------------------------------------------------------------------
# Livy (Pattern Analysis submits Spark jobs directly to the Fabric Livy REST
# endpoint from the browser, under the user's delegated token). See docs/runbook.md.
# ----------------------------------------------------------------------------
# The lakehouse whose Livy endpoint runs the analyses. Required to submit and
# monitor Pattern Analysis jobs; other tabs work without it.
VITE_FABRIC_LAKEHOUSE_ID=
# Optional Fabric Spark Environment id (extra Spark libraries / config). NOT
# required for `tsmp`: the SPA ships the tsmp package inside each Livy statement,
# so leave this blank unless you need additional cluster libraries.
VITE_FABRIC_ENVIRONMENT_ID=
# Space-separated pip requirements the Livy statement installs on the Spark
# driver before running (only if not already importable). The analysis reads /
# ingests the Eventhouse via the azure-kusto SDKs, which a bare Fabric Spark pool
# may not have. Pin versions here if needed, or set to empty to skip (e.g. when a
# Fabric Environment already provides them).
VITE_TSMP_PIP_PACKAGES=azure-kusto-data azure-kusto-ingest
# How the Spark job authenticates to the Eventhouse (Kusto). Default 'fabric_token'
# uses notebookutils.credentials.getToken on the Spark driver, which is required on
# Fabric because Fabric Spark has no IMDS endpoint (so 'managed_identity' fails with
# an IMDS error). Use 'managed_identity' only on non-Fabric MSI hosts, or 'az_cli'
# for local development against Kusto.
VITE_TSMP_KUSTO_AUTH=fabric_token
