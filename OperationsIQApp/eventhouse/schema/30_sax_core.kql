.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Return query-fitted SAX lower breakpoints by nearest-rank quantiles over the query values. The first value is a -infinity sentinel."
) sax_breakpoints_query(query_series:dynamic, alphabet_size:int)
{
    let values =
        print series = query_series
        | mv-expand value = series to typeof(real)
        | where isfinite(value)
        | sort by value asc
        | serialize rn = row_number() - 1;
    let n = toscalar(values | summarize count());
    toscalar(
        range cut_index from 0 to alphabet_size - 1 step 1
        | extend breakpoint = iff(cut_index == 0, real(-1e308), todouble(cut_index) * todouble(n) / todouble(alphabet_size))
        | extend value_rank = tolong(min_of(n - 1, max_of(0, floor(breakpoint, 1))))
        | join kind=leftouter (values | project value_rank = rn, cut_value = value) on value_rank
        | extend cut = iff(cut_index == 0, real(-1e308), cut_value)
        | order by cut_index asc
        | summarize breakpoints = make_list(cut)
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Population z-normalize a dynamic numeric array. Low-variance arrays are mean-centered without division."
) sax_znorm(series:dynamic, znorm_threshold:real)
{
    let n = array_length(series);
    // series_stats_dynamic is scalar and row-safe, so sax_znorm can run per row
    // over dynamic columns used by discords, VSM, and multidim reconstruction.
    let _stats = series_stats_dynamic(series);
    let mean_val = todouble(_stats.avg);
    // series_stats returns sample variance (n-1 divisor); convert to population variance
    let sample_var = todouble(_stats.variance);
    let pop_var = iff(n > 1, sample_var * todouble(n - 1) / todouble(n), 0.0);
    let stdev_val = sqrt(max_of(0.0, pop_var));
    let mean_array = repeat(mean_val, n);
    iff(stdev_val >= znorm_threshold,
        series_divide(series_subtract(series, mean_array), repeat(stdev_val, n)),
        series_subtract(series, mean_array)
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Fractional Piecewise Aggregate Approximation over a dynamic numeric array."
) sax_paa(series:dynamic, paa_size:int)
{
    let n = array_length(series);
    let samples =
        print series = series
        | mv-expand with_itemindex = sample_index value = series to typeof(real)
        | extend sample_index = tolong(sample_index),
                 sample_start = todouble(sample_index),
                 sample_end = todouble(sample_index + 1),
                 join_key = 1;
    let segments =
        range segment_index from 0 to paa_size - 1 step 1
        | extend segment_start = todouble(segment_index) * todouble(n) / todouble(paa_size),
                 segment_end = todouble(segment_index + 1) * todouble(n) / todouble(paa_size),
                 join_key = 1;
    toscalar(
        segments
        | join kind=inner samples on join_key
        | extend overlap = max_of(0.0, min_of(sample_end, segment_end) - max_of(sample_start, segment_start))
        | where overlap > 0.0
        | summarize paa_value = sum(value * overlap) / sum(overlap) by segment_index
        | order by segment_index asc
        | summarize paa = make_list(paa_value)
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Convert PAA values into a SAX word using supplied lower breakpoints."
) sax_symbolize_values(values:dynamic, breakpoints:dynamic, alphabet_size:int)
{
    let alphabet = sax_alphabet(alphabet_size);
    let bp_len = array_length(breakpoints);
    toscalar(
        print values = values
        | mv-expand with_itemindex = position value = values to typeof(real)
        | extend position = tolong(position)
        // For each value, count how many breakpoints it is >= (gives 1-based symbol ordinal)
        | extend symbol_index = toint(array_sum(series_greater_equals(repeat(value, bp_len), breakpoints))) - 1
        | extend symbol = tostring(alphabet[symbol_index])
        | order by position asc
        | summarize symbols = make_list(symbol)
        | project word = strcat_array(symbols, "")
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Convert a dynamic numeric array to a SAX word with supplied lower breakpoints."
) sax_word(series:dynamic, paa_size:int, breakpoints:dynamic, alphabet_size:int, znorm_threshold:real)
{
    sax_symbolize_values(sax_paa(sax_znorm(series, znorm_threshold), paa_size), breakpoints, alphabet_size)
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Euclidean distance between two numeric dynamic arrays of the same logical length."
) sax_euclidean_arrays(left_values:dynamic, right_values:dynamic)
{
    let diff = series_subtract(left_values, right_values);
    sqrt(array_sum(series_multiply(diff, diff)))
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Euclidean distance between PAA representations of two z-normalized series."
) sax_paa_distance(left_series:dynamic, right_series:dynamic, paa_size:int, znorm_threshold:real)
{
    sax_euclidean_arrays(
        sax_paa(sax_znorm(left_series, znorm_threshold), paa_size),
        sax_paa(sax_znorm(right_series, znorm_threshold), paa_size)
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Average per-symbol ordinal distance between two SAX words."
) sax_symbol_distance(left_word:string, right_word:string)
{
    let len = min_of(strlen(left_word), strlen(right_word));
    toscalar(
        range position from 0 to len - 1 step 1
        | extend left_symbol = substring(left_word, position, 1),
                 right_symbol = substring(right_word, position, 1)
        | extend left_index = indexof("abcdefghijklmnopqrst", left_symbol),
                 right_index = indexof("abcdefghijklmnopqrst", right_symbol)
        | summarize distance = iff(len == 0, real(null), avg(todouble(abs(left_index - right_index))))
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Maximum per-position ordinal distance between two SAX words (the tolerance-prefilter metric). Standalone helper; the search functions compute this inline for performance."
) sax_symbol_distance_max(left_word:string, right_word:string)
{
    let len = min_of(strlen(left_word), strlen(right_word));
    toscalar(
        range position from 0 to len - 1 step 1
        | extend left_symbol = substring(left_word, position, 1),
                 right_symbol = substring(right_word, position, 1)
        | extend left_index = indexof("abcdefghijklmnopqrst", left_symbol),
                 right_index = indexof("abcdefghijklmnopqrst", right_symbol)
        | summarize distance = iff(len == 0, real(null), todouble(max(abs(left_index - right_index))))
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Build a regex tolerance pattern for a SAX word. Each symbol is expanded to an ordinal character class."
) sax_tolerance_regex(word:string, alphabet_size:int, symbol_tolerance:int, min_repeat:int, max_repeat:int)
{
    let alphabet = "abcdefghijklmnopqrst";
    toscalar(
        range position from 0 to strlen(word) - 1 step 1
        | extend symbol = substring(word, position, 1)
        | extend center = indexof(alphabet, symbol)
        | extend low = max_of(0, center - symbol_tolerance),
                 high = min_of(alphabet_size - 1, center + symbol_tolerance)
        | extend chars = substring(alphabet, low, high - low + 1)
        | extend token = strcat("[", chars, "]", iff(min_repeat == 1 and max_repeat == 1, "", strcat("{", min_repeat, ",", max_repeat, "}")))
        | order by position asc
        | summarize tokens = make_list(token)
        | project regex = strcat_array(tokens, "")
    )
}

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Convert a distance to a bounded similarity score for ranking."
) sax_similarity_from_distance(distance:real)
{
    1.0 / (1.0 + distance)
}
