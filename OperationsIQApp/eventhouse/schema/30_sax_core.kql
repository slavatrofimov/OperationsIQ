// Core SAX helper functions.
// Deploy with .execute database script <| or copy each .create-or-alter command
// into a KQL database management command.

.create-or-alter function with (
    folder = "SAX/Core",
    docstring = "Return the supported SAX alphabet prefix as a dynamic array."
) sax_alphabet(alphabet_size:int)
{
    array_slice(dynamic([
        "a","b","c","d","e","f","g","h","i","j",
        "k","l","m","n","o","p","q","r","s","t"
    ]), 0, alphabet_size - 1)
}

.create-or-alter function with (
