# ----------------------------------------------------------------------------
# Livy job dispatcher (orchestration/dispatcher.py) — BACKEND service config.
#
# This process runs SERVER-SIDE and this file DOES hold secrets (an Entra
# service-principal secret), so copy it to a secret store / `.env.dispatcher`
# that is never committed.
#
# Run:  python -m orchestration.dispatcher
# Check connectivity first (no job needed):  python -m orchestration.dispatcher preflight
# ----------------------------------------------------------------------------

# --- Fabric workspace + Lakehouse whose Livy endpoint runs the Spark session ---
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
# Optional: pin a Fabric Environment (custom pool + the tsmp wheel). Omit to use the
# workspace starter pool. Wiring this is what makes `import tsmp` resolve on the cluster.
FABRIC_ENVIRONMENT_ID=

# --- Rayfin control plane (GraphQL Data API) ---
RAYFIN_GRAPHQL_URL=http://localhost:5168/api/graphql
# Either a static API token for the control plane, or leave blank to reuse the SPN token.
RAYFIN_API_TOKEN=
# Scope to request when minting a control-plane token from the SPN (if RAYFIN_API_TOKEN
# is blank). Defaults to FABRIC_SCOPE.
RAYFIN_API_SCOPE=

# --- Entra service principal (client-credentials flow) ---------------------------
# The SPN must be a workspace CONTRIBUTOR and be granted the Livy scopes below. The
# tenant admin setting for the Livy API must also be enabled.
#   Required Livy scopes: Lakehouse.Execute.All, Lakehouse.Read.All,
#                         Code.AccessFabric.All, Code.AccessStorage.All
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Token audience for Livy / Fabric REST. Almost always leave this default.
FABRIC_SCOPE=https://api.fabric.microsoft.com/.default

# --- Source Eventhouse/KQL mapping (the signal the analysis reads) ----------------
# The AnalysisJob row only carries `signal_id` (a tag id); the physical source binding
# lives here (mirrors the deployment's connection profile).
TSMP_KQL_CLUSTER_URI=
TSMP_KQL_DATABASE=
TSMP_SOURCE_TABLE=
TSMP_TIME_COLUMN=Timestamp
TSMP_VALUE_COLUMN=Value
TSMP_TAG_COLUMN=TagId
# Where result rows are ingested; defaults to the source cluster/db when blank.
TSMP_RESULT_CLUSTER_URI=
TSMP_RESULT_DATABASE=
# How the Spark job authenticates to Kusto (managed_identity on Fabric).
TSMP_KUSTO_AUTH=managed_identity

# --- Loop + anti-hang timeouts (seconds) -----------------------------------------
DISPATCHER_POLL_INTERVAL_S=15
LIVY_SESSION_START_TIMEOUT_S=300
LIVY_STATEMENT_TIMEOUT_S=3600
LIVY_MAX_RUNTIME_S=7200
